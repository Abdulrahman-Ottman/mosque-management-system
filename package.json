{
  "name": "mosque-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test": "bash supabase/test/run.sh",
    "db:verify": "node --env-file=.env.local scripts/verify-setup.mjs",
    "user:create": "node --env-file=.env.local scripts/create-user.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-dev.mjs",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "verify": "npm run lint && npx tsc --noEmit && npm test && npm run build",
    "visual": "node --env-file=.env.local scripts/visual-check.mjs",
    "db:reset": "node --env-file=.env.local scripts/reset-data.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}

# =============================================================================
# Supabase  —  Project Settings > API Keys
#
# Supabase replaced the old JWT keys with a new pair. The mapping is:
#   old "anon" key          ->  Publishable key   (sb_publishable_...)
#   old "service_role" key  ->  Secret key        (sb_secret_...)
#
# Legacy sb_publishable_/anon JWTs still work if your project shows those instead.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable key — safe to expose to the browser. Subject to RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secret key — BYPASSES RLS. Server-side only.
# Never rename this to start with NEXT_PUBLIC_, or it ships to the browser and
# hands any visitor full read/write access to the whole database.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# The timezone that defines "today" for attendance and the weekly view.
# The Laravel app ran on UTC; change this if the mosque's local day should win.
NEXT_PUBLIC_APP_TZ=UTC
